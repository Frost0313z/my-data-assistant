OPENAI_API_KEY=sk-여기에_본인의_키_입력
OPENAI_MODEL=gpt-4o-mini
CHAT_MAX_TOKENS=900
# 리포트(A14)는 4블록을 채워야 해서 상한이 따로 있다
REPORT_MAX_TOKENS=1200
# 매 요청 다시 올리는 대화 이력의 상한(메시지 수). 입력 토큰이 늘어나는 유일한 무제한 경로였다
HISTORY_MAX_MESSAGES=8
# 요약 캐시 수명(초). 0이면 캐시를 끈다. 쓰기 경로가 직접 비우므로 어긋날 창은 거의 없다
SUMMARY_CACHE_TTL=30
# 배포본 식별자. Render는 RENDER_GIT_COMMIT을 자동으로 넣어 준다 (직접 설정 불필요)
# BUILD_REV=

# 로컬: 서비스 계정 키 파일 경로 / Render 등 배포 환경: JSON 문자열 그대로
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# 콤마로 구분된 허용 오리진 목록 (프론트 배포 URL 포함)
ALLOWED_ORIGINS=http://localhost:5500,https://your-frontend.vercel.app
