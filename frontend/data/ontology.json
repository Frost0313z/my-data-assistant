{
  "@context": {
    "@vocab": "https://schema.org/",
    "@language": "ko",
    "label": "name",
    "aliases": "alternateName",
    "unit": "unitText",
    "metrics": "variableMeasured",

    "answers": null,
    "cannot": null,
    "periods": null,
    "grain": null,
    "stages": null,
    "refuse": null,
    "negations": null,
    "promptTerms": null,
    "chips": null,
    "accepts": null,
    "embed": null,
    "personas": null,
    "sameLabelAs": null,
    "patterns": null,
    "constraints": null
  },

  "@type": "Dataset",
  "name": "대전 상권 온톨로지 사전",
  "description": "질문에서 지표·지역·시점·무대를 알아내 화면을 맞추기 위한 통제 어휘. 수치는 담지 않는다 — 수치의 출처는 backend/app/seed/insights.md 하나뿐이고, 여기에 베끼면 세 곳이 되어 갈라진다.",

  "refuse": [
    {
      "id": "sales",
      "label": "매출",
      "patterns": ["매출", "수익", "얼마 버", "얼마나 버", "돈 되", "돈이 되", "장사 잘", "객단가"],
      "promptTerms": ["매출"],
      "message": "이 데이터에는 매출이 없습니다. 등록 업소의 수와 구성만 있어서 얼마를 버는지는 알 수 없습니다.",
      "chips": [
        { "text": "점포 교체율로 보기", "metric": "turnover" },
        { "text": "점포 잔존율로 보기", "metric": "survival" }
      ]
    },
    {
      "id": "footfall",
      "label": "유동인구",
      "patterns": ["유동인구", "유동 인구", "사람 많", "사람이 많", "발길", "통행량", "방문객", "손님 많"],
      "promptTerms": ["유동인구"],
      "message": "이 데이터에는 유동인구가 없습니다. 거리에 사람이 얼마나 다니는지는 알 수 없습니다.",
      "chips": [
        { "text": "공급 밀도로 보기", "metric": "density" },
        { "text": "등록 업소 수로 보기", "metric": "stores" }
      ]
    },
    {
      "id": "rent",
      "label": "임대료",
      "patterns": ["임대료", "월세", "보증금", "권리금", "임차"],
      "promptTerms": ["임대료"],
      "message": "이 데이터에는 임대료가 없습니다. 자리값이 얼마인지는 알 수 없습니다.",
      "chips": []
    }
  ],

  "negations": ["말고", "빼고", "아니라", "아니고", "대신", "제외", "없이"],

  "metrics": [
    {
      "@id": "#density",
      "@type": "PropertyValue",
      "key": "density",
      "label": "공급 밀도",
      "unit": "개",
      "grain": "dong",
      "periods": "single",
      "aliases": ["공급밀도", "밀도", "촘촘", "빽빽", "포화", "경쟁 심", "경쟁이 심", "인구 대비", "인구당", "천 명당"],
      "answers": "주민 수에 비해 가게가 얼마나 많은가",
      "cannot": ["매출", "유동인구", "임대료", "업종별 밀도"]
    },
    {
      "@id": "#stores",
      "@type": "PropertyValue",
      "key": "stores",
      "label": "등록 업소 수",
      "unit": "개",
      "grain": "dong",
      "periods": "single",
      "aliases": ["업소 수", "업소수", "점포 수", "점포수", "가게 수", "가게수", "몇 개", "몇개", "규모"],
      "answers": "그 동네에 등록된 업소가 몇 개인가",
      "cannot": ["매출", "유동인구", "업소의 크기"]
    },
    {
      "@id": "#survival",
      "@type": "PropertyValue",
      "key": "survival",
      "label": "점포 잔존율",
      "unit": "%",
      "grain": "dong",
      "periods": "single",
      "aliases": ["잔존율", "생존율", "살아남", "버티", "버텼", "오래 가", "오래가", "유지되", "남아 있"],
      "answers": "처음에 있던 가게 중 몇 퍼센트가 아직 남아 있는가",
      "cannot": ["매출", "특정 점포의 생존 여부", "왜 남았는지"]
    },
    {
      "@id": "#turnover",
      "@type": "PropertyValue",
      "key": "turnover",
      "label": "점포 교체율",
      "unit": "%",
      "grain": "dong",
      "periods": "all",
      "sameLabelAs": "stage:turnover",
      "aliases": ["교체율", "자주 바뀌", "자주바뀌", "바뀌는", "바뀐", "망하", "망해", "망했", "폐업", "문 닫", "문닫", "간판 바뀌", "들락"],
      "answers": "한 동네에서 가게가 얼마나 자주 바뀌는가",
      "cannot": ["매출", "유동인구", "특정 점포의 폐업 여부", "왜 바뀌었는지"]
    },
    {
      "@id": "#hhi",
      "@type": "PropertyValue",
      "key": "hhi",
      "label": "업종 집중도",
      "unit": "",
      "grain": "dong",
      "periods": "single",
      "aliases": ["집중도", "업종 구성", "업종구성", "다양", "쏠려", "쏠림", "치우", "한 업종", "무슨 업종 많"],
      "answers": "그 동네의 업종이 한쪽으로 쏠려 있는가 고른가",
      "cannot": ["매출", "어떤 업종이 몇 개인지", "업종별 증감"]
    },
    {
      "@id": "#change",
      "@type": "PropertyValue",
      "key": "change",
      "label": "업소 수 증감",
      "unit": "%",
      "grain": "dong",
      "periods": "all",
      "aliases": ["증감", "늘었", "줄었", "늘어난", "줄어든", "성장", "정체", "위축", "변화", "추이"],
      "answers": "그 동네의 업소 수가 늘었는가 줄었는가",
      "cannot": ["매출", "유동인구", "왜 늘고 줄었는지"]
    },
    {
      "@id": "#type",
      "@type": "PropertyValue",
      "key": "type",
      "label": "지역 유형",
      "unit": "",
      "grain": "dong",
      "periods": "single",
      "aliases": ["지역 유형", "유형", "어떤 동네", "어떤 지역", "분류"],
      "answers": "밀도와 교체율 두 축으로 나눈 네 유형 중 어디인가",
      "cannot": ["매출", "유형 사이의 좋고 나쁨", "리포트의 다른 지표(LQ 등)와의 연결"]
    }
  ],

  "stages": [
    {
      "@id": "#stage-map",
      "id": "map",
      "label": "지도",
      "grain": "dong",
      "accepts": {
        "metric": ["density", "stores", "survival", "turnover", "hhi", "change", "type"],
        "period": "*",
        "district": "*",
        "dong": "*",
        "category": "*",
        "view": ["2d", "3d"]
      },
      "answers": "한 지역의 값은 얼마인가 · 대전 전체에서 어디가 높고 낮은가",
      "cannot": ["두 자치구를 나란히 비교", "업종 × 자치구 교차", "두 시점 직접 비교"]
    },
    {
      "@id": "#stage-scale",
      "id": "scale",
      "label": "전체 규모·성장",
      "embed": "only=stats,series&series=city",
      "grain": "city",
      "accepts": { "series": ["city", "district", "category", "dong"] },
      "answers": "대전 전체 업소 수가 시간에 따라 어떻게 변했는가",
      "cannot": ["행정동별 값", "업종별 교차"]
    },
    {
      "@id": "#stage-district",
      "id": "district",
      "label": "자치구별 증감",
      "embed": "only=bar&bar=district&sort=growth",
      "grain": "district",
      "accepts": {
        "bar": ["district", "category", "dong"],
        "sort": ["change", "growth", "score"]
      },
      "answers": "자치구끼리 나란히 놓으면 어디가 더 늘었는가",
      "cannot": ["행정동 단위 값(bar=dong으로 바꾸면 가능)", "업종 교차"]
    },
    {
      "@id": "#stage-industry",
      "id": "industry",
      "label": "업종별 증감",
      "embed": "only=heatmap",
      "grain": "district×industry",
      "accepts": {},
      "answers": "어떤 업종이 어느 자치구에서 늘고 줄었는가",
      "cannot": ["행정동 단위 업종 구성", "업소 수 절대값"]
    },
    {
      "@id": "#stage-growth",
      "id": "growth",
      "label": "성장·정체 지역",
      "embed": "only=growth",
      "grain": "dong",
      "accepts": {},
      "answers": "증감률과 잔존율을 두 축에 놓으면 어느 동네가 부흥이고 위축인가",
      "cannot": ["매출", "업종 교차"]
    },
    {
      "@id": "#stage-turnover",
      "id": "turnover",
      "label": "교체율 산점도",
      "embed": "only=turnover",
      "grain": "dong",
      "sameLabelAs": "metric:turnover",
      "answers": "순증감과 교체율을 두 축에 놓으면 어느 동네가 제자리인데 속으로 갈리는가",
      "accepts": {},
      "cannot": ["한 지역의 값만 보기(그건 지도다)", "업종 교차"]
    }
  ],

  "personas": {
    "explore": "stores",
    "prepare": "density",
    "running": "hhi"
  },

  "constraints": [
    {
      "id": "category-vs-period",
      "message": "업종별 점 데이터는 최신 한 시점만 있습니다. 업종을 고르면 시점은 바꿀 수 없습니다.",
      "when": { "category": "set" },
      "blocks": ["period"]
    },
    {
      "id": "all-period-metrics",
      "message": "교체율과 증감은 전 기간을 합쳐 계산한 값이라 특정 시점을 고를 수 없습니다.",
      "when": { "metricPeriods": "all" },
      "blocks": ["period"]
    }
  ]
}
